---
// src/pages/audit.astro — Arkonium · mini-audit craftsmanship
// Autonome : aucune dépendance, aucun framework. Utilise les tokens de global.css.
import Base from '../layouts/Base.astro';
const CAL_URL = 'https://cal.com/arnaud-oltra-7js2wv/15min?overlayCalendar=true&month=2026-08';
const HOOK_URL = 'https://hook.us2.make.com/ov2kd4hpsef1e56u8g7l7bpgmjytwaxm';
---

<Base lang="fr" titre="Auto-diagnostic craftsmanship — Arkonium" description="16 questions, 8 axes. Vos trois priorités, ce qu'elles coûtent, et par où commencer.">
  <div class="ark-audit" data-cal={CAL_URL} data-hook={HOOK_URL}>
    <div class="aa-progress"><i></i></div>

    <!-- ── Intro ───────────────────────────────────────────── -->
    <section class="aa-pane" data-pane="intro">
      <div class="aa-wrap">
        <div class="aa-lede">
          <span class="aa-eyebrow">Auto-diagnostic · 16 questions · 6 minutes</span>
          <h1>Votre équipe construit-elle du logiciel qui dure&nbsp;?</h1>
          <p class="aa-big">Huit axes, deux questions chacun. Aucune bonne réponse à deviner&nbsp;: on regarde ce qui se passe vraiment chez vous. À la fin, vos trois priorités, ce qu'elles coûtent, et par où commencer.</p>
          <p class="aa-fine">Rien n'est envoyé, rien n'est stocké. Pas de courriel demandé pour voir le résultat.</p>
          <div class="aa-actions">
            <button class="aa-btn" data-act="start">Commencer le diagnostic →</button>
            <a class="aa-btn aa-btn--outline" data-cal-link target="_blank" rel="noopener">Parler à quelqu'un plutôt</a>
          </div>
        </div>
      </div>
      <div class="aa-band">
        <div class="aa-wrap">
          <span class="aa-eyebrow">Ce qu'on regarde</span>
          <div class="aa-axes" data-axes></div>
        </div>
      </div>
    </section>

    <!-- ── Questions ───────────────────────────────────────── -->
    <section class="aa-pane" data-pane="quiz" hidden>
      <div class="aa-wrap aa-wrap--narrow">
        <div class="aa-meta">
          <span class="aa-eyebrow" data-axis-eyebrow></span>
          <span class="aa-counter" data-counter></span>
        </div>
        <div class="aa-bar"></div>
        <h2 class="aa-question" data-question></h2>
        <div class="aa-options" data-options></div>
        <div class="aa-nav">
          <button class="aa-btn aa-btn--ghost" data-act="back">← Précédent</button>
          <span class="aa-counter">Touches 1 – 4 pour répondre</span>
        </div>
      </div>
    </section>

    <!-- ── Résultat ────────────────────────────────────────── -->
    <section class="aa-pane" data-pane="result" hidden>
      <div class="aa-wrap">
        <div class="aa-lede">
          <span class="aa-eyebrow">Votre résultat</span>
          <h2 class="aa-level" data-level-title></h2>
          <p class="aa-big" data-level-line></p>
        </div>

        <div class="aa-scores" data-scores></div>

        <div class="aa-section">
          <span class="aa-eyebrow">Vos trois priorités</span>
          <h3>Là où ça coûte le plus, maintenant.</h3>
          <div class="aa-prios" data-prios></div>
        </div>

        <div class="aa-offer">
          <div class="aa-offer__main">
            <span class="aa-eyebrow aa-eyebrow--dark">Par où commencer</span>
            <h3 data-offer-title></h3>
            <p data-offer-body></p>
            <p class="aa-offer__meta" data-offer-meta></p>
          </div>
          <div class="aa-offer__cta">
            <p class="aa-offer__hook">30 minutes, sans jargon et sans engagement.</p>
            <p class="aa-offer__sub">On reprend vos trois priorités et on regarde si on est les bonnes personnes. Si on ne l'est pas, on le dira.</p>
            <a class="aa-btn" data-cal-link target="_blank" rel="noopener">Choisir un créneau →</a>
            <span class="aa-counter">arkonium.tech · Arno · fondateur</span>
          </div>
        </div>

        <div class="aa-section">
          <button class="aa-btn aa-btn--outline" data-act="restart">Refaire le diagnostic</button>
        </div>
      </div>
    </section>
  </div>
</Base>

<style is:global>
body{display:flex; flex-direction:column; min-height:100dvh}
main{flex:1}
.ark-audit{
  --creme-card:var(--creme-carte); --creme-deep:var(--creme-fonce);
  --ink:var(--anthracite); --ink2:var(--texte-secondaire); --line:var(--bordure);
  --cuivre-deep:#9A5530; --cuivre-soft:rgba(176,101,58,.08);
  --ok:#4F8A5B; --warn:#C58A2E; --danger:#B84A3A; --ink-dark:#A9A595;
  --serif:var(--font-display); --sans:var(--font-body); --mono:var(--font-mono);
  --ease:cubic-bezier(.22,.61,.36,1);
  background:var(--creme); color:var(--ink); font-family:var(--sans);
}
.ark-audit *{box-sizing:border-box}
.aa-wrap{max-width:1240px; margin:0 auto; padding:0 28px}
.aa-wrap--narrow{max-width:820px}
.aa-lede{max-width:760px}

.aa-progress{position:sticky; top:0; z-index:40; height:2px; background:transparent}
.aa-progress i{display:block; height:2px; width:0; background:var(--cuivre); transition:width 260ms var(--ease)}

.aa-pane{padding:72px 0 8px}
.aa-eyebrow{font-family:var(--mono); font-size:12px; font-weight:500; letter-spacing:.16em; text-transform:uppercase; color:var(--cuivre)}
.aa-eyebrow--dark{color:var(--acier)}
.aa-counter{font-family:var(--mono); font-size:11px; letter-spacing:.13em; text-transform:uppercase; color:var(--taupe)}

.ark-audit h1{font-family:var(--serif); font-weight:500; font-size:clamp(2.4rem,1.6rem + 3.2vw,3.8rem); line-height:1.08; letter-spacing:-.015em; margin:20px 0 0; text-wrap:balance}
.aa-level{font-family:var(--serif); font-weight:500; font-size:clamp(2.2rem,1.5rem + 2.6vw,3.2rem); line-height:1.1; letter-spacing:-.015em; margin:18px 0 0}
.aa-big{font-size:20px; line-height:1.55; color:var(--ink2); margin:20px 0 0; max-width:660px; text-wrap:pretty}
.aa-fine{font-size:16px; line-height:1.6; color:var(--taupe); margin:16px 0 0; max-width:640px}

.aa-actions{display:flex; gap:14px; margin-top:34px; flex-wrap:wrap}
.aa-btn{display:inline-flex; align-items:center; justify-content:center; gap:8px;
  font-family:var(--sans); font-weight:500; font-size:16px; padding:14px 28px; border-radius:7px;
  border:1px solid var(--cuivre); background:var(--cuivre); color:var(--creme);
  line-height:1.1; white-space:nowrap; cursor:pointer; text-decoration:none;
  transition:background 180ms var(--ease), color 180ms var(--ease), transform 130ms var(--ease)}
.aa-btn:hover{background:var(--cuivre-deep); color:var(--creme)}
.aa-btn:active{transform:translateY(.5px)}
.aa-btn--outline{background:transparent; color:var(--cuivre)}
.aa-btn--outline:hover{background:var(--cuivre-soft); color:var(--cuivre)}
.aa-btn--ghost{background:transparent; color:var(--cuivre); border-color:transparent; font-size:15px; padding:11px 18px}
.aa-btn--ghost:hover{background:var(--cuivre-soft); color:var(--cuivre)}

.aa-band{background:var(--creme-deep); border-top:1px solid var(--line); margin-top:56px; padding:56px 0}
.aa-axes{display:grid; grid-template-columns:repeat(4,1fr); gap:16px; margin-top:28px}
.aa-axe{background:var(--creme-card); border:1px solid var(--line); border-radius:10px; padding:18px 18px 20px; box-shadow:0 1px 2px rgba(43,43,40,.05)}
.aa-axe b{display:block; font-family:var(--serif); font-weight:500; font-size:19px; line-height:1.25; margin-top:8px}
.aa-axe span{font-family:var(--mono); font-size:11px; letter-spacing:.14em; color:var(--taupe)}

.aa-meta{display:flex; align-items:baseline; justify-content:space-between; gap:20px}
.aa-bar{height:3px; width:28px; background:var(--cuivre); border-radius:2px; margin-top:22px}
.aa-question{font-family:var(--serif); font-weight:500; font-size:clamp(1.75rem,1.3rem + 1.6vw,2.4rem); line-height:1.2; letter-spacing:-.01em; margin:22px 0 0; text-wrap:pretty}
.aa-options{display:flex; flex-direction:column; gap:10px; margin-top:34px}
.aa-opt{display:flex; gap:16px; align-items:flex-start; text-align:left; width:100%;
  padding:18px 20px; background:var(--creme-card); border:1px solid var(--line); border-radius:10px;
  font-family:var(--sans); font-size:17px; line-height:1.55; color:var(--ink); cursor:pointer;
  box-shadow:0 1px 1px rgba(43,43,40,.04);
  transition:border-color 140ms var(--ease), background 140ms var(--ease), transform 140ms var(--ease), box-shadow 140ms var(--ease)}
.aa-opt:hover{border-color:var(--cuivre); transform:translateY(-2px); box-shadow:0 2px 8px rgba(43,43,40,.07)}
.aa-opt[aria-pressed="true"]{background:var(--cuivre-soft); border-color:var(--cuivre)}
.aa-opt i{font-family:var(--mono); font-size:12px; letter-spacing:.08em; color:var(--cuivre); font-style:normal; padding-top:3px; flex:none; width:18px}
.aa-nav{display:flex; align-items:center; justify-content:space-between; gap:16px; margin-top:28px}

.aa-scores{border-top:1px solid var(--line); margin-top:44px; padding-top:36px;
  display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:26px 48px}
.aa-score b{font-size:16px; font-weight:500}
.aa-score header{display:flex; align-items:baseline; justify-content:space-between; gap:16px}
.aa-score em{font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; font-style:normal}
.aa-score div{height:6px; background:var(--creme-deep); border-radius:3px; margin-top:10px; overflow:hidden}
.aa-score div i{display:block; height:6px; border-radius:3px; width:0; transition:width 420ms var(--ease)}

.aa-section{margin-top:64px}
.ark-audit h3{font-family:var(--serif); font-weight:500; font-size:clamp(1.6rem,1.2rem + 1.2vw,2.1rem); margin:14px 0 0; letter-spacing:-.01em}
.aa-prios{display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:20px; margin-top:32px}
.aa-prio{background:var(--creme-card); border:1px solid var(--line); border-left:3px solid var(--cuivre);
  border-radius:10px; padding:24px; box-shadow:0 1px 2px rgba(43,43,40,.05); display:flex; flex-direction:column; gap:14px}
.aa-prio .aa-counter{color:var(--taupe)}
.aa-prio p{margin:0}
.aa-prio .aa-risk{font-family:var(--serif); font-weight:500; font-size:20px; line-height:1.3; text-wrap:pretty}
.aa-prio .aa-cost{font-size:16px; line-height:1.6; color:var(--ink2); padding-top:12px; border-top:1px solid var(--line); text-wrap:pretty}
.aa-prio .aa-cost span{display:block; margin-bottom:6px; font-family:var(--mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--cuivre)}

.aa-offer{margin-top:64px; background:var(--graphite); border-radius:14px; padding:clamp(32px,4vw,56px);
  display:grid; grid-template-columns:minmax(0,1.35fr) minmax(0,1fr); gap:clamp(28px,4vw,56px); align-items:start}
.aa-offer__main{border-left:3px solid var(--cuivre); padding-left:26px}
.aa-offer__main h3{color:var(--creme); font-size:clamp(1.9rem,1.4rem + 1.6vw,2.6rem); line-height:1.15; margin-top:16px}
.aa-offer__main p{font-size:18px; line-height:1.6; color:var(--ink-dark); margin:16px 0 0; text-wrap:pretty}
.aa-offer__meta{font-family:var(--mono); font-size:12px; letter-spacing:.14em; text-transform:uppercase; color:var(--acier) !important; margin-top:20px !important}
.aa-offer__cta{display:flex; flex-direction:column; gap:18px}
.aa-offer__hook{font-family:var(--serif); font-weight:500; font-size:22px; line-height:1.35; color:var(--creme); margin:0; text-wrap:pretty}
.aa-offer__sub{font-size:16px; line-height:1.6; color:var(--ink-dark); margin:0}

@media (max-width:900px){
  .aa-axes{grid-template-columns:repeat(2,1fr)}
  .aa-prios{grid-template-columns:1fr}
  .aa-scores{grid-template-columns:1fr}
  .aa-offer{grid-template-columns:1fr}
}
@media (prefers-reduced-motion:reduce){ .ark-audit *{transition:none !important} }
</style>

<script>
  const AXES = [
    { label: 'Tests & filet de sécurité',
      risk: "Chaque livraison est un pari. Sans filet, la régression est découverte par vos clients avant vous.",
      cost: "Des correctifs d'urgence non planifiés, et une équipe qui livre en retenant son souffle.",
      qs: [
        { q: "Quand quelqu'un modifie une partie sensible du code, qu'est-ce qui l'avertit s'il casse quelque chose ?",
          o: ["Rien. On le découvre en prod, ou un client nous le dit.",
              "Un test manuel, si quelqu'un pense à le faire.",
              "Des tests automatisés, mais on ne sait pas trop ce qu'ils couvrent.",
              "Une suite qui échoue avant le merge, sur les parcours critiques."] },
        { q: "Un bug est corrigé. Que se passe-t-il ensuite ?",
          o: ["On corrige et on passe au suivant.",
              "On corrige, et on espère qu'il ne revienne pas.",
              "On ajoute un test quand on a le temps.",
              "Un test reproduit le bug avant le correctif — il ne peut plus revenir."] } ] },
    { label: 'Déploiement & mise en prod',
      risk: "Livrer coûte cher, donc vous livrez moins souvent — et chaque mise en prod devient plus risquée.",
      cost: "Des semaines entre une décision d'affaires et son effet réel sur le marché.",
      qs: [
        { q: "Mettre en production, chez vous, c'est…",
          o: ["Un événement planifié, le soir ou la fin de semaine.",
              "Faisable, mais quelqu'un doit suivre une procédure manuelle.",
              "Un pipeline automatisé, avec quelques étapes manuelles.",
              "Un non-événement : plusieurs fois par semaine, en pleine journée."] },
        { q: "Combien de temps entre « le code est prêt » et « c'est en prod » ?",
          o: ["Des semaines — on attend la prochaine fenêtre.",
              "Quelques jours.",
              "Moins d'une journée.",
              "Moins d'une heure, et on sait revenir en arrière."] } ] },
    { label: 'Architecture & couplage',
      risk: "Le couplage transforme chaque petit changement en projet. Votre capacité à réagir se dégrade en silence.",
      cost: "Des estimations qui doublent, et un « non » de plus en plus fréquent aux demandes du métier.",
      qs: [
        { q: "Ajouter une fonctionnalité aujourd'hui, comparé à il y a deux ans…",
          o: ["Beaucoup plus long, et personne n'ose vraiment l'admettre.",
              "Plus long, on s'y est habitués.",
              "À peu près pareil.",
              "Aussi rapide — la base absorbe le changement."] },
        { q: "Changer un fournisseur (paiement, courriel, stockage), ça touche…",
          o: ["On ne sait pas. Il faudrait chercher partout.",
              "Beaucoup d'endroits, dispersés dans le code.",
              "Quelques endroits identifiés.",
              "Un seul point d'entrée, isolé du métier."] } ] },
    { label: 'Qualité de code & revue',
      risk: "Sans critères partagés, la qualité dépend de qui a écrit le code ce jour-là.",
      cost: "Une base hétérogène, des revues qui n'attrapent rien, et de la reprise de travail.",
      qs: [
        { q: "Une revue de code chez vous, ça ressemble à…",
          o: ["Il n'y en a pas — on pousse directement.",
              "Un « LGTM » rapide pour débloquer la PR.",
              "Une vraie lecture, mais la barre varie selon qui relit.",
              "Une conversation sur la conception, avec des critères partagés."] },
        { q: "Sur ce qui fait du « bon code » dans votre équipe…",
          o: ["Chacun a son avis, et ça se voit dans le code.",
              "Il y a un consensus tacite, jamais écrit.",
              "Des conventions écrites, appliquées inégalement.",
              "Des règles explicites, outillées, et rediscutées quand elles gênent."] } ] },
    { label: 'Dette technique & legacy',
      risk: "La dette non budgétée ne disparaît pas : elle se paie en vélocité, avec intérêts.",
      cost: "Une part croissante du temps d'équipe absorbée par le contournement plutôt que la création.",
      qs: [
        { q: "La dette technique, dans votre planification…",
          o: ["N'existe pas comme sujet. On livre des fonctionnalités.",
              "On en parle quand ça brûle.",
              "Une part du temps est prévue, souvent sacrifiée.",
              "Un budget assumé et défendu à chaque cycle."] },
        { q: "Y a-t-il une zone du code que personne ne veut toucher ?",
          o: ["Oui, et une seule personne la comprend encore.",
              "Oui, et on la contourne systématiquement.",
              "Oui, mais on la démonte petit à petit.",
              "Non — plus de zone interdite."] } ] },
    { label: 'Onboarding & transmission',
      risk: "Le savoir concentré sur quelques personnes est un risque de continuité, pas un détail RH.",
      cost: "Des mois avant qu'un nouveau soit rentable — et un départ qui coûte très cher.",
      qs: [
        { q: "Un nouveau dev arrive. Il livre sa première vraie contribution en…",
          o: ["Plusieurs mois, s'il reste.",
              "Six à huit semaines.",
              "Deux à trois semaines.",
              "Quelques jours — l'environnement et le contexte sont prêts."] },
        { q: "Si votre dev le plus ancien partait demain…",
          o: ["Ce serait grave. Beaucoup de choses ne sont que dans sa tête.",
              "Douloureux. On s'en remettrait lentement.",
              "Gérable, il resterait des trous documentés.",
              "Absorbable — le savoir circule déjà dans l'équipe."] } ] },
    { label: "Culture & droit de refactorer",
      risk: "Si améliorer le code n'est pas légitime, personne ne le fera. La base ne peut que se dégrader.",
      cost: "L'usure des bons devs, qui partent grandir ailleurs.",
      qs: [
        { q: "Un dev voit du code à améliorer sur son chemin. Il…",
          o: ["N'y touche pas — trop risqué, et ce n'est pas dans le ticket.",
              "Demande une autorisation qui n'arrive jamais.",
              "Le fait discrètement, sans le dire.",
              "Le fait, l'explique en revue, et c'est légitime."] },
        { q: "Quand un incident arrive, la première question posée est…",
          o: ["Qui a fait ça ?",
              "Comment on éteint le feu — on verra après.",
              "Qu'est-ce qui a manqué ? — parfois.",
              "Qu'est-ce qui a rendu ça possible ? — systématiquement, sans blâme."] } ] },
    { label: 'IA & conception',
      risk: "L'IA écrit le code plus vite que jamais. Sans culture d'ingénierie, c'est de la dette à vitesse industrielle.",
      cost: "Une base qui grossit plus vite que la compréhension qu'on en a.",
      qs: [
        { q: "Le code généré par IA, chez vous, passe…",
          o: ["Directement, si ça marche.",
              "Une relecture rapide, sans critère particulier.",
              "La même revue que le reste.",
              "La même revue, plus une exigence : le dev doit pouvoir défendre la conception."] },
        { q: "L'IA a surtout changé…",
          o: ["La vitesse à laquelle du code qu'on ne comprend pas entre dans la base.",
              "Le volume produit, sans qu'on sache si c'est mieux.",
              "La productivité, avec une vigilance nouvelle sur la conception.",
              "Notre façon de travailler : on dirige l'IA avec des critères clairs."] } ] },
  ];

  const LEVELS = [
    { min: 0,  name: 'Fragile', color: 'var(--danger)' },
    { min: 40, name: 'Solide',  color: 'var(--warn)' },
    { min: 70, name: 'Durable', color: 'var(--ok)' },
  ];
  const LINES = {
    Fragile: "La base tient, mais elle tient sur des personnes et sur de la chance. Ce n'est pas un jugement : c'est une compétence qui manque, et une compétence, ça se transmet.",
    Solide:  "Les fondations sont là. Ce qui manque, c'est la constance — les bons réflexes existent, mais ils cèdent dès que le calendrier serre.",
    Durable: "Vous avez la culture, et ça se voit dans les réponses. La suite, c'est de la garder vivante quand l'équipe grandit et que la pression monte.",
  };
  const OFFERS = {
    Fragile: { title: 'Le micro-audit', meta: 'Votre code · constats chiffrés · point de départ',
      body: "Avant de former quoi que ce soit, il faut voir l'écart noir sur blanc : où la base vous ralentit, ce que ça coûte, et dans quel ordre le reprendre. C'est aussi la matière d'un atelier sur votre stack, pas sur un exemple." },
    Solide: { title: "L'atelier", meta: '1 journée · équipe + décideurs',
      body: "Les fondations sont là, la constance manque. Une journée de refactoring en direct sur une vraie base legacy — la vôtre si un audit a été fait. Vous repartez avec une méthode, pas un show." },
    Durable: { title: 'Le mentorat', meta: "Récurrent · au cœur de l'équipe",
      body: "Vous avez la culture. Ce qui la tue, c'est le relâchement sous pression. Un accompagnement récurrent dans l'équipe pour l'ancrer pour de bon — jusqu'à ce que vous n'ayez plus besoin de nous." },
  };

  const root = document.querySelector('.ark-audit');
  const FLAT = [];
  AXES.forEach((a, ai) => a.qs.forEach((q) => FLAT.push({ ai, q: q.q, o: q.o })));
  const pad = (n) => String(n).padStart(2, '0');
  const lvl = (p) => LEVELS.reduce((acc, l) => (p >= l.min ? l : acc), LEVELS[0]);
  const $ = (s) => root.querySelector(s);
  const panes = { intro: $('[data-pane="intro"]'), quiz: $('[data-pane="quiz"]'), result: $('[data-pane="result"]') };

  let i = 0;
  const answers = {};

  root.querySelectorAll('[data-cal-link]').forEach((a) => { a.href = root.dataset.cal; });

  $('[data-axes]').innerHTML = AXES.map((a, k) =>
    `<div class="aa-axe"><span>${pad(k + 1)} / 08</span><b>${a.label}</b></div>`).join('');

  function show(name) {
    Object.entries(panes).forEach(([k, el]) => { el.hidden = k !== name; });
    const answered = Object.keys(answers).length;
    $('.aa-progress i').style.width =
      (name === 'result' ? 100 : name === 'intro' ? 0 : Math.round((answered / FLAT.length) * 100)) + '%';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderQuestion() {
    const cur = FLAT[i];
    $('[data-axis-eyebrow]').textContent = pad(cur.ai + 1) + ' / 08 · ' + AXES[cur.ai].label;
    $('[data-counter]').textContent = 'Question ' + pad(i + 1) + ' / ' + FLAT.length;
    $('[data-question]').textContent = cur.q;
    $('[data-options]').innerHTML = cur.o.map((t, k) =>
      `<button class="aa-opt" type="button" data-v="${k}" aria-pressed="${answers[i] === k}"><i>${k + 1}</i><span>${t}</span></button>`).join('');
    $('.aa-progress i').style.width = Math.round((Object.keys(answers).length / FLAT.length) * 100) + '%';
  }

  function answer(v) {
    if (v < 0 || v > 3) return;
    answers[i] = v;
    renderQuestion();
    setTimeout(() => {
      if (i + 1 >= FLAT.length) { renderResult(); show('result'); }
      else { i += 1; renderQuestion(); }
    }, 170);
  }

  function renderResult() {
    const sc = AXES.map((a, ai) => {
      const idx = FLAT.map((f, k) => (f.ai === ai ? k : -1)).filter((k) => k >= 0);
      const raw = idx.reduce((s, k) => s + (answers[k] ?? 0), 0);
      const pct = Math.round((raw / (idx.length * 3)) * 100);
      const L = lvl(pct);
      return { label: a.label, pct, level: L.name, color: L.color, risk: a.risk, cost: a.cost };
    });
    const overall = Math.round(sc.reduce((s, a) => s + a.pct, 0) / sc.length);
    const L = lvl(overall);

    $('[data-level-title]').textContent = L.name + ' — ' + overall + ' / 100';
    $('[data-level-line]').textContent = LINES[L.name];
    $('[data-scores]').innerHTML = sc.map((a) =>
      `<div class="aa-score"><header><b>${a.label}</b><em style="color:${a.color}">${a.level}</em></header>
       <div><i style="background:${a.color}" data-w="${a.pct}"></i></div></div>`).join('');
    requestAnimationFrame(() => {
      root.querySelectorAll('.aa-score i').forEach((el) => { el.style.width = el.dataset.w + '%'; });
    });

    $('[data-prios]').innerHTML = sc.slice().sort((a, b) => a.pct - b.pct).slice(0, 3).map((p, k) =>
      `<div class="aa-prio"><span class="aa-counter">Priorité ${k + 1} · ${p.label}</span>
        <p class="aa-risk">${p.risk}</p>
        <p class="aa-cost"><span>Ce que ça coûte</span>${p.cost}</p></div>`).join('');

    const o = OFFERS[L.name];
    $('[data-offer-title]').textContent = o.title;
    $('[data-offer-body]').textContent = o.body;
    $('[data-offer-meta]').textContent = o.meta;

    sendResults(sc, overall, L);
  }

  function sendResults(sc, overall, L) {
    const hook = root.dataset.hook;
    if (!hook) return;
    fetch(hook, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        level: L.name,
        overall,
        axes: sc.map(a => ({ label: a.label, pct: a.pct, level: a.level })),
        top3: sc.slice().sort((a, b) => a.pct - b.pct).slice(0, 3)
          .map(p => ({ label: p.label, risk: p.risk, cost: p.cost })),
        answers: FLAT.map((f, k) => ({
          axis: AXES[f.ai].label,
          question: f.q,
          answer: f.o[answers[k] ?? 0],
          value: answers[k] ?? 0
        })),
        ts: new Date().toISOString()
      })
    }).catch(() => {});
  }

  root.addEventListener('click', (e) => {
    const opt = e.target.closest('.aa-opt');
    if (opt) { answer(Number(opt.dataset.v)); return; }
    const act = e.target.closest('[data-act]')?.dataset.act;
    if (act === 'start') { i = 0; renderQuestion(); show('quiz'); }
    if (act === 'back') { if (i === 0) show('intro'); else { i -= 1; renderQuestion(); } }
    if (act === 'restart') { i = 0; Object.keys(answers).forEach((k) => delete answers[k]); show('intro'); }
  });

  document.addEventListener('keydown', (e) => {
    if (panes.quiz.hidden) return;
    if (e.key >= '1' && e.key <= '4') { answer(Number(e.key) - 1); e.preventDefault(); }
    else if (e.key === 'ArrowLeft' || e.key === 'Backspace') {
      if (i === 0) show('intro'); else { i -= 1; renderQuestion(); }
      e.preventDefault();
    }
  });
</script>
